// Prisma schema for The Tapa Co.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
  SUPER_USER
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

model RitualGuide {
  id                    String   @id @default(cuid())
  title                 String
  slug                  String   @unique
  status ContentStatus @default(DRAFT)

  // Banner Content fields
  sectionLabel          String?
  category              String?
  rating                String?
  classification        String?
  guideTitle            String?
  guideSubtitle         String?

  // Panchang Configuration fields
  festivalName          String?
  panchangLocation      String?

  // Primary Button fields
  primaryButtonText     String?
  primaryButtonAction   String?
  primaryButtonTarget   String?

  // Secondary Button fields
  secondaryButtonText   String?
  secondaryButtonAction String?
  secondaryButtonTarget String?

  // Third Button fields
  thirdButtonText       String?
  thirdButtonAction     String?
  thirdButtonTarget     String?

  // Source of Truth Section fields
  sotSectionHeading        String?
  sotButtonText            String?
  sotButtonAction          String?
  sotButtonTarget          String?
  sotPracticeLabel         String?
  sotPracticeTitle         String?
  sotPracticeCategory      String?
  sotPracticeRating        String?
  sotPracticeClassification String?
  sotScripturalSource      String?
  sotParentScripture       String?
  sotSourceReference       String?
  sotSourceUrl             String?
  sotSourceNotes           String?
  sotSummaryLabel          String?
  sotCorePracticesCount    Int?
  sotScripturalElementsCount Int?
  sotRegionalCustomsCount  Int?
  sotCorrectionsCount      Int?

  // Story Section fields
  storyTitle               String?
  storyIntroduction        String?
  storySubsectionTitle     String?
  storyContent             String?
  storyPracticeCategory    String?
  storyPracticeRating       String?
  storyPracticeClassification String?
  storyScripturalSource    String?
  storyContinuation        String?
  storyImage               String?
  storyImageAltText        String?
  storyImageCaption        String?
  storyImageCredit         String?
  storyImageSource         String?

  // Sankalpa Section fields
  sankalpaTitle            String?
  sankalpaSubtitle         String?
  sankalpaInstruction      String?
  sankalpaText             String?
  sankalpaMeaning          String?
  sankalpaExplanation      String?
  sankalpaDetailsJson      String?
  sankalpaNoteHeading      String?
  sankalpaNoteContent      String?
  sankalpaImage            String?

  // Vidhi Section fields
  vidhiDaysJson            String?

  // Vrat Katha Section fields
  kathaTitle                  String?
  kathaSubtitle               String?
  kathaScripturalReference    String?
  kathaHeadline               String?
  kathaIntroduction           String?
  kathaCardsJson              String?
  kathaSupportingExplanation  String?
  kathaAudio                  String?
  kathaAudioButtonText        String?
  kathaAudioDuration           String?
  kathaFullKathaButtonText    String?
  kathaFullKathaLink          String?
  kathaImage                  String?
  kathaImageAltText           String?
  kathaImageCaption           String?

  // Durga Ashtami and Maha Navami Context fields
  festivalContextTitle        String?
  festivalContextIntroduction String?
  festivalContextDetails      String?
  festivalPracticeCategory    String?
  festivalPracticeRating       String?
  festivalClassification      String?
  sandhiPujaInformation       String?

  // Samagri Section fields
  samagriTitle                String?
  samagriSubtitle             String?
  samagriItemsJson            String?
  samagriAudio                String?
  samagriAudioButtonText      String?
  samagriAudioDuration        String?

  // Fasting Section fields
  fastingTitle                String?
  fastingSubtitle             String?
  fastingOptionsJson          String?
  fastingGuidanceHeading      String?
  fastingGuidanceContent      String?

  // Myths & Corrections Section fields
  mythsTitle                  String?
  mythsSubtitle               String?
  mythsItemsJson              String?



  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([slug])
  @@index([status])
  @@index([status, category])
}

model DharmicConcept {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  category  String   @default("General")
  summary   String?
  body      String
  status ContentStatus @default(DRAFT) // DRAFT, PUBLISHED, ARCHIVED

  // Banner Section Fields
  bannerEyebrow          String?
  bannerRating           String?
  bannerClassification   String?
  bannerTitle            String?
  bannerDescription      String?
  bannerPrimaryCtaText   String?
  bannerPrimaryCtaLink   String?
  bannerSecondaryCtaText String?
  bannerSecondaryCtaLink String?
  bannerShareButtonText  String?

  // Three Stories Section Fields
  threeStoriesTitle          String?
  threeStoriesIntro          String?
  threeStoriesSupportingText String?
  storiesItemsJson           String? // JSON array of repeatable story items
  threeStoriesGalleryJson    String? // JSON array of gallery images
  threeStoriesCaption        String?

  // What They Share Section Fields
  shareSectionHeading        String?
  shareSharedContent         String?
  shareNotSharedContent      String?
  shareHighlightStatement    String?
  shareSupportingDescription String?
  shareTraditionTag          String?

  // Myths & Facts Section Fields
  mythsSectionHeading        String?
  mythsItemsJson             String? // JSON array of repeatable myth & fact items
  reframeLabel               String?
  reframeContent             String?

  // Related Section Fields
  relatedRitualGuidesJson    String? // JSON array of related ritual guides
  relatedPujansJson          String? // JSON array of related pujans
  relatedConceptsJson        String? // JSON array of related concepts
  relatedDatesJson           String? // JSON array of related dates

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([slug])
  @@index([status])
  @@index([category])
  @@index([authorId])
  @@index([status, category])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  phone         String?   @unique
  phoneVerified DateTime?
  password      String?
  role            UserRole  @default(CUSTOMER)
  activeSessionId String?
  createdAt       DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  dharmicConcepts DharmicConcept[]
  orders         Order[]

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([role, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model OtpVerification {
  id          String   @id @default(cuid())
  phone       String   @unique
  hashedOtp   String
  attempts    Int      @default(0)
  maxAttempts Int      @default(3)
  expiresAt   DateTime
  lastSentAt  DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
}

model BeginnerGuide {
  id                     String   @id @default(cuid())
  title                  String
  slug                   String   @unique
  category               String   @default("General")
  status ContentStatus @default(DRAFT) // DRAFT, PUBLISHED, ARCHIVED

  // Banner Section Fields
  bannerEyebrow          String?
  bannerBadgeText        String?
  bannerBadgeIcon        String?
  bannerTitle            String?
  bannerDescription      String?
  bannerPrimaryCtaText   String?
  bannerPrimaryCtaAction String?
  bannerPrimaryCtaTarget String?
  bannerSecondaryCtaText String?
  bannerSecondaryCtaAction String?
  bannerSecondaryCtaTarget String?
  bannerShareEnabled     Boolean  @default(true)
  bannerShareButtonText  String?  @default("Share")

  // Intro Section Fields
  introHeading           String?
  introDescription       String?
  introImage             String?
  introImageAltText      String?
  introImageCaption      String?

  // Why / Seven Kandas Section Fields
  whySectionHeading      String?
  whySectionSubtitle     String?
  kandasJson             String? // JSON array of repeatable Kanda items

  // Where to Start Section Fields
  whereToStartHeading           String?
  whereToStartIntro             String?
  whereToStartHighlight         String?
  whereToStartSupporting        String?
  whereToStartSubHeading        String?
  whereToStartSubIntro          String?
  whereToStartFinalDescription  String?

  // Common Worries Section Fields
  commonWorriesHeading          String?
  commonWorriesSubtitle         String?
  commonWorriesJson             String? // JSON array of repeatable worry items
  commonWorriesClosing          String?

  // What to Read Next Section Fields
  whatToReadNextHeading         String?
  whatToReadNextSubtitle        String?
  whatToReadNextItemsJson       String? // JSON array of repeatable related content items

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([slug])
  @@index([status])
  @@index([status, category])
}

model PanchangEntry {
  id            String   @id @default(cuid())
  date          String   // e.g. "1/1/2026" or "2026-01-01"
  dateObj       DateTime @unique
  year          Int
  tithiName     String   // e.g. "Trayodashi"
  tithiDetail   String   // e.g. "13th day"
  paksha        String   // e.g. "Shukla"
  pakshaDetail  String   // e.g. "Waxing moon"
  nakshatra     String   // e.g. "Rohini"
  isAuspicious  Boolean  @default(false)
  sunrise       String   // e.g. "6:53"
  sunset        String   // e.g. "15:49"
  location      String   @default("New Delhi, India")
  source        String   @default("AUTO SYNCED")
  lastSynced    String?  // e.g. "25/08/2026"
  status        String   @default("PUBLISHED")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([year])
  @@index([date])
  @@index([isAuspicious, dateObj])
  @@index([year, paksha, tithiName])
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLATION_REQUESTED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  COD
  RAZORPAY
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  customerName    String
  customerMobile  String
  customerEmail   String
  
  streetAddress   String
  city            String
  state           String
  pincode         String
  country         String        @default("India")
  
  subtotal        Int
  deliveryCharge  Int           @default(0)
  grandTotal      Int
  
  paymentMethod   PaymentMethod @default(COD)
  paymentStatus   PaymentStatus @default(PENDING)
  orderStatus     OrderStatus   @default(PLACED)

  razorpayOrderId   String?       @unique
  razorpayPaymentId String?
  razorpaySignature String?

  userId          String?
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  items           OrderItem[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([orderNumber])
  @@index([razorpayOrderId])
  @@index([customerMobile])
  @@index([customerEmail])
  @@index([orderStatus])
  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  productId     String
  productName   String
  unitPrice     Int
  quantity      Int
  lineTotal     Int
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([orderId])
  @@index([productId])
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum ProductCategory {
  BY_FESTIVAL
  BY_RITUAL
  GRIHA_LIFE_EVENTS
  DAILY_PUJA_ESSENTIALS
}


model Product {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  description      String?       @db.Text
  category         ProductCategory @default(BY_FESTIVAL)
  price            Int           // Numeric price in INR without ₹ symbol

  stock            Int           @default(0)
  status           ProductStatus @default(ACTIVE)
  featuredImage    String?       @db.Text // Exact single featured image URL/reference
  imagesJson       String?       @db.Text // JSON array of string image URLs/references
  samagriItemsJson       String?       @db.Text // JSON array of { id, itemName, quantity, unit }

  // Significance & How to Use Section
  significanceLabel      String?
  significanceHeading    String?
  significanceDescription String?       @db.Text
  whatsInsideLabel       String?
  whatsInsideHeading     String?
  whatsInsideDescription  String?       @db.Text
  howToUseLabel          String?
  howToUseHeading        String?
  howToUseStepsJson      String?       @db.Text // JSON array of { text, order }
  supportingText         String?

  // Delivery & Policies Section
  dispatchInfo           String?       @db.Text
  expectedDelivery       String?
  serviceableAreas       String?
  courierInfo            String?       @db.Text

  cancellationInfo       String?       @db.Text
  cancellationPolicyText String?
  cancellationPolicyUrl  String?
  returnsInfo            String?       @db.Text
  returnsPolicyText      String?
  returnsPolicyUrl       String?
  damageInTransitInfo    String?       @db.Text
  damageClaimText        String?
  damageClaimUrl         String?

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([slug])
  @@index([status])
  @@index([category])
  @@index([status, category])
  @@index([status, createdAt])
}

model Source {
  id             String   @id @default(cuid())
  title          String
  sanskritTitle  String?
  category       String   @default("Purana")
  citationsCount Int      @default(0)
  isVerified     Boolean  @default(true)
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([category])
}

model Faq {
  id           String   @id @default(cuid())
  question     String
  answer       String   @db.Text
  category     String   @default("General")
  helpfulVotes Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
}

model AnnouncementBar {
  id        String    @id @default(cuid())
  title     String
  message   String    @db.Text
  type      String    @default("Header Banner")
  targetUrl String?
  isActive  Boolean   @default(true)
  startDate DateTime?
  endDate   DateTime?
  priority  Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([isActive])
}

model UpcomingFeature {
  id            String   @id @default(cuid())
  key           String?  @unique
  title         String
  category      String   @default("General")
  status        String   @default("In Planning")
  targetRelease String?
  description   String?  @db.Text
  priority      String   @default("Medium")
  requests      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
}

model Subscriber {
  id             String    @id @default(cuid())
  name           String
  whatsappNumber String    @unique
  optInDate      DateTime  @default(now())
  consentGiven   Boolean   @default(true)
  status         String    @default("Active")
  userId         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([whatsappNumber])
  @@index([status])
}

model AuditLog {
  id        String   @id @default(cuid())
  event     String
  actor     String   @default("system@tapa.co")
  role      String   @default("SYSTEM")
  target    String?
  ipAddress String?
  severity  String   @default("INFO")
  details   String?  @db.Text
  userId    String?
  createdAt DateTime @default(now())

  @@index([event])
  @@index([severity])
  @@index([createdAt])
}

model ConsentLog {
  id           String   @id @default(cuid())
  userId       String?
  email        String
  phone        String?
  consentGiven Boolean  @default(true)
  version      String   @default("v1.0")
  ip           String?
  createdAt    DateTime @default(now())

  @@index([email])
  @@index([userId])
}

model DownloadLog {
  id           String   @id @default(cuid())
  userId       String?
  userEmail    String?
  resourceId   String
  resourceType String
  createdAt    DateTime @default(now())

  @@index([resourceId])
  @@index([userId])
}

model HeaderCategory {
  id           String   @id @default(cuid())
  key          String   @unique // e.g. "rg", "pa", "dc", "rk"
  title        String
  displayOrder Int      @default(0)
  status       String   @default("PUBLISHED")
  columnsJson  String   @db.Text
  featuredJson String   @db.Text
  footerJson   String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([key])
  @@index([status])
  @@index([displayOrder])
}

model FooterConfig {
  id              String   @id @default(cuid())
  key             String   @unique // "default"
  brandJson       String   @db.Text
  utilityJson     String   @db.Text
  sitemapJson     String   @db.Text
  columnsJson     String   @db.Text
  correctionsJson String   @db.Text
  legalJson       String   @db.Text
  status          String   @default("PUBLISHED")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([key])
  @@index([status])
}
model GlossaryTerm {
  id                  String        @id @default(cuid())
  term                String
  slug                String        @unique
  language            String        @default("SANSKRIT")
  devanagari          String?
  pronunciation       String?
  category            String        @default("PRACTICE")
  definition          String        @db.Text
  appearsInJson       String?       @db.Text
  relatedConceptTitle String?
  relatedConceptSlug  String?
  status              ContentStatus @default(PUBLISHED)
  displayOrder        Int           @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([slug])
  @@index([status])
  @@index([category])
  @@index([language])
}

model AboutPage {
  id                         String   @id @default(cuid())
  key                        String   @unique @default("default")
  
  // Hero
  heroEyebrow                String?
  heroTitle                  String?
  heroStandfirst             String?  @db.Text
  heroParagraph1             String?  @db.Text
  heroParagraph2             String?  @db.Text
  heroPullQuote              String?  @db.Text
  filmLogo                   String?  @db.Text
  filmSpec                   String?

  // Why Tapa Section
  whySectionNumber           String?
  whyTitleDevanagari         String?
  whyDevanagariDesc          String?  @db.Text
  whyParagraph2              String?  @db.Text
  founderTrayTitle           String?
  founderName                String?
  founderDesignation         String?
  founderLetterTitle         String?
  founderLetterP1            String?  @db.Text
  founderLetterP2            String?  @db.Text
  founderLetterP3            String?  @db.Text
  founderLetterP4            String?  @db.Text
  founderLetterP5            String?  @db.Text
  founderFamilyImage         String?  @db.Text
  founderFamilyCaption       String?
  founderPullQuote1          String?  @db.Text
  founderLetterP6            String?  @db.Text
  founderLetterP7            String?  @db.Text
  founderLetterP8            String?  @db.Text
  founderSignatureName       String?
  founderSignatureTitle      String?
  founderSignatureCompany    String?
  founderPullQuote2          String?  @db.Text
  founderLetterP9            String?  @db.Text
  founderLetterP10           String?  @db.Text
  founderAvatar              String?  @db.Text
  coreValuesHeading          String?
  coreValuesSubtitle         String?
  coreValuesIntro            String?  @db.Text

  // Editorial Method
  editorialSectionNumber     String?
  editorialTitle             String?
  editorialStandfirst        String?  @db.Text
  editorialDharmaTitle       String?
  editorialDharmaSub         String?
  editorialDharmaDesc        String?  @db.Text
  editorialPrathaTitle       String?
  editorialPrathaSub         String?
  editorialPrathaDesc        String?  @db.Text
  editorialBhrantiTitle      String?
  editorialBhrantiSub        String?
  editorialBhrantiDesc       String?  @db.Text
  editorialRuleText          String?  @db.Text
  editorialConsensusText     String?
  editorialSeparatedText     String?  @db.Text
  editorialWeighTitle        String?
  editorialWeighP1           String?  @db.Text
  editorialWeighP2           String?  @db.Text
  editorialCtaText           String?
  editorialCtaUrl            String?

  // Glossary Section
  glossarySectionNumber      String?
  glossaryTitle              String?
  glossaryStandfirst         String?  @db.Text
  glossaryParagraph1         String?  @db.Text
  glossaryParagraph2         String?  @db.Text
  glossaryCtaText            String?
  glossaryCtaUrl             String?

  // Ritual Kits Section
  kitsSectionNumber          String?
  kitsTitle                  String?
  kitsStandfirst             String?  @db.Text
  kitsParagraph1             String?  @db.Text
  kitsParagraph2             String?  @db.Text
  kitsHeading                String?
  kitsNote                   String?
  kitsCtaText                String?
  kitsCtaUrl                 String?

  // Puja With Purohit Section
  purohitSectionNumber       String?
  purohitTitle               String?
  purohitChipText            String?
  purohitParagraph           String?  @db.Text
  purohitBookingHeading      String?
  purohitArrangeHeading      String?
  purohitNotHappenHeading    String?
  purohitNotHappenDesc       String?  @db.Text
  purohitNotifyCtaText       String?

  // Tapa Circle Section
  circleSectionNumber        String?
  circleTitle                String?
  circlePriceChip            String?
  circleStandfirst           String?  @db.Text
  circleParagraph1           String?  @db.Text
  circleParagraph2           String?  @db.Text
  circleTrayTitle            String?
  circleLeavingNote          String?  @db.Text
  circleJoinCtaText          String?

  // Closing Section
  closingLabel               String?
  closingPreText             String?
  closingText                String?  @db.Text
  closingLogo                String?  @db.Text

  // Relations
  coreValues                 AboutCoreValue[]
  editorialSources           AboutEditorialSource[]
  kitPoints                  AboutRitualKitPoint[]
  purohitBookingPoints       AboutPurohitBookingPoint[]
  purohitArrangementPoints   AboutPurohitArrangementPoint[]
  circleSteps                AboutCircleStep[]

  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model AboutCoreValue {
  id          String    @id @default(cuid())
  aboutPageId String
  aboutPage   AboutPage @relation(fields: [aboutPageId], references: [id], onDelete: Cascade)
  number      String
  title       String
  description String    @db.Text
  sortOrder   Int       @default(0)

  @@index([aboutPageId])
  @@index([sortOrder])
}

model AboutEditorialSource {
  id          String    @id @default(cuid())
  aboutPageId String
  aboutPage   AboutPage @relation(fields: [aboutPageId], references: [id], onDelete: Cascade)
  source      String
  score       String
  sortOrder   Int       @default(0)

  @@index([aboutPageId])
  @@index([sortOrder])
}

model AboutRitualKitPoint {
  id          String    @id @default(cuid())
  aboutPageId String
  aboutPage   AboutPage @relation(fields: [aboutPageId], references: [id], onDelete: Cascade)
  title       String
  description String    @db.Text
  sortOrder   Int       @default(0)

  @@index([aboutPageId])
  @@index([sortOrder])
}

model AboutPurohitBookingPoint {
  id          String    @id @default(cuid())
  aboutPageId String
  aboutPage   AboutPage @relation(fields: [aboutPageId], references: [id], onDelete: Cascade)
  title       String
  description String    @db.Text
  sortOrder   Int       @default(0)

  @@index([aboutPageId])
  @@index([sortOrder])
}

model AboutPurohitArrangementPoint {
  id          String    @id @default(cuid())
  aboutPageId String
  aboutPage   AboutPage @relation(fields: [aboutPageId], references: [id], onDelete: Cascade)
  title       String
  description String    @db.Text
